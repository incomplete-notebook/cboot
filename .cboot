    cmt "基类"
    cd ..
    mem type char*
    cmt "类型"
    cd ..
  cd ..
  struct Project
  mode api
  cmt "项目状态"
    mem name char*
    cmt "项目名"
    cd ..
    mem root Domain*
    cmt "根域"
    cd ..
