# CBoot self-bootstrapping script
# 用cboot自身来描述cboot项目
project cboot

mod domain
cmt "域数据模型"
  type DomainType
  mode api rename
  value "int"
  cmt "域类型枚举"
  cd ..
  type ModMode
  mode api rename
  value "int"
  cmt "模块模式: internal/external"
  cd ..
  type ApiMode
  mode api rename
  value "int"
  cmt "API模式: api/normal"
  cd ..
  type TypeMode
  mode api rename
  value "int"
  cmt "类型模式: rename/struct/api rename/api struct"
  cd ..
  type VarMode
  mode api rename
  value "int"
  cmt "变量模式: static/normal"
  cd ..
  type RunMode
  mode api rename
  value "int"
  cmt "运行模式"
  cd ..
  struct Comment
  mode api
  cmt "注释"
    mem target char*
    cmt "目标"
    cd ..
    mem text char*
    cmt "文本"
    cd ..
  cd ..
  struct Domain
  mode api
  cmt "域基类"
    mem type DomainType
    cmt "域类型"
    cd ..
    mem name char*
    cmt "名称"
    cd ..
    mem parent Domain*
    cmt "父域"
    cd ..
    mem children Domain**
    cmt "子域数组"
    cd ..
    mem child_count int
    cmt "子域数量"
    cd ..
    mem child_capacity int
    cmt "子域容量"
    cd ..
    mem comments Comment*
    cmt "注释数组"
    cd ..
    mem comment_count int
    cmt "注释数量"
    cd ..
    mem comment_capacity int
    cmt "注释容量"
    cd ..
    mem comment char*
    cmt "域注释"
    cd ..
  cd ..
  struct ModuleDomain
  mode api
  cmt "模块域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode ModMode
    cmt "模块模式"
    cd ..
    mem value char*
    cmt "值"
    cd ..
    mem includes char**
    cmt "包含文件数组"
    cd ..
    mem include_count int
    cmt "包含文件数量"
    cd ..
    mem include_capacity int
    cmt "包含文件容量"
    cd ..
    mem dependencies char**
    cmt "依赖数组"
    cd ..
    mem dep_count int
    cmt "依赖数量"
    cd ..
    mem dep_capacity int
    cmt "依赖容量"
    cd ..
  cd ..
  struct FunctionDomain
  mode api
  cmt "函数域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode ApiMode
    cmt "API模式"
    cd ..
    mem return_type char*
    cmt "返回类型"
    cd ..
    mem code char*
    cmt "代码"
    cd ..
    mem value char*
    cmt "值"
    cd ..
  cd ..
  struct StructDomain
  mode api
  cmt "结构体域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode ApiMode
    cmt "API模式"
    cd ..
  cd ..
  struct TypeDomain
  mode api
  cmt "类型域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode TypeMode
    cmt "类型模式"
    cd ..
    mem value char*
    cmt "值"
    cd ..
  cd ..
  struct MacroDomain
  mode api
  cmt "宏域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode ApiMode
    cmt "API模式"
    cd ..
    mem value char*
    cmt "值"
    cd ..
  cd ..
  struct VariableDomain
  mode api
  cmt "变量域"
    mem base Domain
    cmt "基类"
    cd ..
    mem mode VarMode
    cmt "变量模式"
    cd ..
    mem type char*
    cmt "类型"
    cd ..
    mem value char*
    cmt "值"
    cd ..
  cd ..
  struct MemberDomain
  mode api
  cmt "成员域"
