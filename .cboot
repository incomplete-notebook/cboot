    cd ..
  cd ..
  void domain_add_child void
  mode api
  cmt "添加子域"
    mem parent Domain*
    cmt "父域"
    cd ..
    mem child Domain*
    cmt "子域"
    cd ..
  cd ..
  void domain_delete void
  mode api
  cmt "删除域"
    mem domain Domain*
    cmt "域"
    cd ..
  cd ..
  void domain_remove_child void
  mode api
  cmt "移除子域"
