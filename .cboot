    cmt "父域"
    cd ..
    mem name char*
    cmt "名称"
    cd ..
  cd ..
  void domain_find_nearest_of_type Domain*
  mode api
  cmt "向上查找最近类型域"
    mem from Domain*
    cmt "起始域"
    cd ..
    mem type DomainType
    cmt "域类型"
    cd ..
  cd ..
  void domain_get_path char*
  mode api
  cmt "获取域路径"
    mem domain Domain*
    cmt "域"
    cd ..
  cd ..
  void domain_set_comment void
  mode api
  cmt "设置注释"
    mem domain Domain*
    cmt "域"
    cd ..
    mem text char*
    cmt "文本"
    cd ..
  cd ..
  void domain_set_value void
  mode api
  cmt "设置值"
    mem domain Domain*
    cmt "域"
    cd ..
    mem value char*
    cmt "值"
    cd ..
  cd ..
  void domain_set_mode void
  mode api
  cmt "设置模式"
    mem domain Domain*
    cmt "域"
    cd ..
    mem mode int
    cmt "模式"
    cd ..
  cd ..
  void project_new Project*
  mode api
  cmt "创建项目"
    mem name char*
    cmt "项目名"
    cd ..
  cd ..
  void project_free void
  mode api
  cmt "释放项目"
    mem proj Project*
    cmt "项目"
    cd ..
  cd ..
cd ..

