# CBoot project file for cboot
# 通过引用各顶级模块的 .cboot 文件来构建整个项目

project cboot

# im 依赖链记录:
# im-dep: /cupdate -> /domain (domain)
# im-dep: /commands -> /domain (domain)
# im-dep: /commands -> /cupdate (cupdate)
# im-dep: /parser -> /domain (domain)
# im-dep: /generator -> /domain (domain)
# im-dep: /docgen -> /domain (domain)
# im-dep: /typecheck -> /domain (domain)
# im-dep: /utils -> /domain (domain)
# im-dep: /main -> /domain (domain)
# im-dep: /main -> /cupdate (cupdate)

# 顶级模块引用
domain/.cboot
cupdate/.cboot
commands/.cboot
parser/.cboot
generator/.cboot
docgen/.cboot
typecheck/.cboot
utils/.cboot
main/.cboot

gen
