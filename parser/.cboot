# CBoot minimal file for module parser
# 此文件在模块 parser 作用域下执行，不需要 mod parser

cmt "脚本解析器 - 解析.cboot脚本文件为项目定义"
mode src
cmode normal
im domain
void parse_cboot int
cd parse_cboot
mode api
cmt "解析.cboot脚本文件"
value "逐行读取脚本，分派命令到对应处理函数，支持#注释"
mem filepath char*
cmt "文件路径"
mem proj struct Project*
cmt "输出项目"
cd ..
void dispatch_script_line int
cd dispatch_script_line
mode api
cmt "分派单行脚本命令"
value "根据首个分词(命令名)调用对应cmd_函数"
mem tokens char**
cmt "分词数组"
mem count int
cmt "分词数量"
cd ..

# 子模块引用
domain/.cboot

# End of .cboot for parser
