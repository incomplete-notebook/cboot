void run_project int
cd run_project
mode api
cmt "输出参数：返回警告数量（可为NULL）"
value "遍历所有src模式模块，读取.c文件，解析C声明，更新code字段和API定义，重新生成.cboot"
mem proj Project*
mem error_count_out int*
mem warning_count_out int*
tcode <<EOF
const char *tdir = "/tmp/cboot_test_run_proj";
char cmd[256];
snprintf(cmd, sizeof(cmd), "rm -rf %s && mkdir -p %s/mymod", tdir, tdir);
system(cmd);
char cwd[1024]; getcwd(cwd, sizeof(cwd));
chdir(tdir);
FILE *fp = fopen("mymod/mymod.c", "w");
if (fp) { fputs("int mymod_add(int a, int b) { return a + b; }\n", fp); fclose(fp); }
Project *p = domain_project_new("testproj");
ModuleDomain *mod = domain_module_domain_new("mymod");
mod->mode = MOD_MODE_SRC;
domain_domain_add_child((Domain*)p->root, (Domain*)mod);
int errs = 0, warns = 0;
int rc = cupdate_run_project(p, &errs, &warns);
EXPECT(rc == 0, "run_project: should return 0, got %d", rc);
chdir(cwd);
domain_project_free(p);
snprintf(cmd, sizeof(cmd), "rm -rf %s", tdir);
system(cmd);
EOF
