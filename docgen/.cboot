# CBoot minimal file for module docgen
# 此文件在模块 docgen 作用域下执行，不需要 mod docgen

cmt "文档生成器 - 生成README.md/API.md/DEV.md三种文档"
mode src
cmode normal
im domain
void generate_docs int
cd generate_docs
mode api
cmt "生成项目级文档"
value "生成README.md、DEV.md和DEPENDENCIES.md"
mem proj struct Project*
cmt "项目定义"
mem output_dir char*
cmt "输出目录"
cd ..
void generate_module_docs void
cd generate_module_docs
mode api
cmt "为单个模块生成文档"
value "生成README.md(模块说明+子模块链接)、API.md(仅API项)、DEV.md(所有项+业务逻辑)"
mem mod struct Domain*
cmt "模块域"
mem dir char*
cmt "模块目录路径"
cd ..

# 子模块引用
domain/.cboot

# End of .cboot for docgen
