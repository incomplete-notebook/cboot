# CBoot minimal file for module docgen
# 此文件在模块 docgen 作用域下执行，不需要 mod docgen

cmt "文档生成器 - 生成README.md/API.md/DEV.md三种文档"
mode src
cmode normal
code <<EOF
/*
 * CBoot - C Project Bootstrapping Tool v0.3.1
 * Documentation generator (新规范 v0.3.1)
 *
 * 生成三种文档:
 *  - README.md: 模块说明 + 子模块链接 (面向用户)
 *  - API.md:    API 模式项的定义和注释 (面向 API 消费者)
 *  - DEV.md:    所有注释 + 业务逻辑 + 依赖链 (面向开发者)
 *
 * 每个模块只管自己的文档，子模块通过链接引用。
 * 内容有重复是可接受的 — 不同文档给不同的人看。
 */

#include "cboot.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

/* ------------------------------------------------------------------ */
/* Forward declarations                                               */
/* ------------------------------------------------------------------ */

static void docgen_generate_mod_readme(Domain *mod, const char *dir);
static void docgen_generate_mod_api(Domain *mod, const char *dir);
static void docgen_generate_mod_dev(Domain *mod, const char *dir);
static void docgen_generate_project_readme(Project *proj, const char *output_dir);
static void docgen_generate_project_dev(Project *proj, const char *output_dir);
static void docgen_generate_dependencies_doc(Project *proj, const char *output_dir);

/* ------------------------------------------------------------------ */
/* Helpers                                                             */
/* ------------------------------------------------------------------ */

static int docgen_is_api(Domain *d) {
    if (!d) return 0;
    switch (d->type) {
        case DOMAIN_FUNCTION:
            return ((FunctionDomain *)d)->mode == API_MODE_API;
        case DOMAIN_STRUCT:
            return ((StructDomain *)d)->mode == API_MODE_API;
        case DOMAIN_TYPE:
            return ((TypeDomain *)d)->mode == TYPE_MODE_API_RENAME ||
                   ((TypeDomain *)d)->mode == TYPE_MODE_API_STRUCT;
        case DOMAIN_MACRO:
            return ((MacroDomain *)d)->mode == API_MODE_API;
        default:
            return 0;
    }
}

static const char *docgen_domain_type_str(int type) {
    switch (type) {
        case DOMAIN_FUNCTION: return "函数";
        case DOMAIN_STRUCT:   return "结构体";
        case DOMAIN_TYPE:     return "类型";
        case DOMAIN_MACRO:    return "宏";
        case DOMAIN_MEMBER:   return "成员";
        case DOMAIN_VARIABLE: return "变量";
        default:              return "未知";
    }
}

/* ================================================================== */
/* docgen_generate_docs - top-level documentation generator                  */
/* ================================================================== */

int docgen_generate_docs(Project *proj, const char *output_dir) {
    if (!proj) return -1;

    utils_ensure_dir(output_dir);

    docgen_generate_project_readme(proj, output_dir);
    docgen_generate_project_dev(proj, output_dir);
    docgen_generate_dependencies_doc(proj, output_dir);

    return 0;
}

/* Called from generator after module dir is created */
void docgen_generate_module_docs(Domain *mod, const char *dir) {
    if (!mod || mod->type != DOMAIN_MODULE) return;

    docgen_generate_mod_readme(mod, dir);
    docgen_generate_mod_api(mod, dir);
    docgen_generate_mod_dev(mod, dir);

    for (int i = 0; i < mod->child_count; i++) {
        if (mod->children[i]->type == DOMAIN_MODULE) {
            char sub_dir[MAX_PATH_LEN];
            snprintf(sub_dir, sizeof(sub_dir), "%s/%s", dir, mod->children[i]->name);
            docgen_generate_module_docs(mod->children[i], sub_dir);
        }
    }
}

/* ================================================================== */
/* docgen_generate_dependencies_doc - DEPENDENCIES.md                        */
/* ================================================================== */

/* 写 API 依赖段落 */
static void docgen_write_api_deps(Project *proj, FILE *f) {
    if (proj->dep_count <= 0) {
        fprintf(f, "## API 依赖 (im 导入)\n\n无 API 依赖。\n\n");
        return;
    }
    fprintf(f, "## API 依赖 (im 导入)\n\n");
    fprintf(f, "以下依赖通过 `im` 命令建立，仅导入 API 定义，不复制实现。\n\n");

    fprintf(f, "### 依赖视图\n\n");
    fprintf(f, "| 依赖方 | 被依赖方 | 来源文件 |\n");
    fprintf(f, "|--------|----------|----------|\n");
    for (int i = 0; i < proj->dep_count; i++) {
        fprintf(f, "| `%s` | `%s` | %s |\n",
                proj->dependencies[i].importer,
                proj->dependencies[i].source,
                proj->dependencies[i].cboot_file ? proj->dependencies[i].cboot_file : "-");
    }
    fprintf(f, "\n");

    fprintf(f, "### 被依赖视图\n\n");
    fprintf(f, "| 被依赖方 | 依赖方 | 来源文件 |\n");
    fprintf(f, "|----------|--------|----------|\n");
    for (int i = 0; i < proj->dep_count; i++) {
        fprintf(f, "| `%s` | `%s` | %s |\n",
                proj->dependencies[i].source,
                proj->dependencies[i].importer,
                proj->dependencies[i].cboot_file ? proj->dependencies[i].cboot_file : "-");
    }
    fprintf(f, "\n");

    fprintf(f, "### 依赖链\n\n```\n");
    for (int i = 0; i < proj->dep_count; i++) {
        fprintf(f, "%s --> %s",
                proj->dependencies[i].importer,
                proj->dependencies[i].source);
        if (proj->dependencies[i].cboot_file)
            fprintf(f, "  (%s)", proj->dependencies[i].cboot_file);
        fprintf(f, "\n");
    }
    fprintf(f, "```\n\n");
}

static void docgen_generate_dependencies_doc(Project *proj, const char *output_dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/DEPENDENCIES.md", output_dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s 依赖关系\n\n", proj->name);
    fprintf(f, "本文档由 CBoot 自动生成，记录项目内模块间的依赖关系。\n\n");

    docgen_write_api_deps(proj, f);

    if (proj->import_count > 0) {
        fprintf(f, "## 完整项目导入 (in 导入)\n\n");
        fprintf(f, "以下项目通过 `in` 命令完整复制为子模块。\n\n");
        fprintf(f, "| 序号 | 来源文件 |\n");
        fprintf(f, "|------|----------|\n");
        for (int i = 0; i < proj->import_count; i++) {
            fprintf(f, "| %d | %s |\n", i + 1, proj->imported_projects[i]);
        }
        fprintf(f, "\n");
    } else {
        fprintf(f, "## 完整项目导入 (in 导入)\n\n无完整项目导入。\n\n");
    }

    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}

/* ================================================================== */
/* docgen_generate_project_readme - project-level README.md                  */
/* ================================================================== */

/* 写入模块列表章节 */
static void docgen_proj_readme_write_modules(Project *proj, FILE *f) {
    fprintf(f, "## 模块\n\n");
    for (int i = 0; i < proj->root->child_count; i++) {
        Domain *child = proj->root->children[i];
        if (child->type != DOMAIN_MODULE) continue;
        fprintf(f, "- [%s](%s/README.md)", child->name, child->name);
        if (child->comment) fprintf(f, ": %s", child->comment);
        fprintf(f, "\n");
    }
    fprintf(f, "\n");
}

/* 写入单个模块在目录树中的条目 */
static void docgen_proj_readme_write_mod_entry(Domain *child, FILE *f) {
    ModuleDomain *md = (ModuleDomain *)child;
    int is_external = (md->mode == MOD_MODE_EXTERNAL);
    int is_prebuilt = (md->mode == MOD_MODE_STATIC || md->mode == MOD_MODE_DYNAMIC);

    fprintf(f, "├── %s/", child->name);
    if (is_prebuilt && md->value) {
        fprintf(f, "  (mode: %s, lib: %s)",
                md->mode == MOD_MODE_STATIC ? "static" : "dynamic", md->value);
    }
    fprintf(f, "\n");

    if (is_external || is_prebuilt) {
        fprintf(f, "│   ├── %s.h\n", child->name);
    } else if (md->compiler == COMPILER_EXE) {
        fprintf(f, "│   ├── main.c\n");
        fprintf(f, "│   ├── %s.h\n", child->name);
    } else {
        fprintf(f, "│   ├── %s.c\n", child->name);
        fprintf(f, "│   ├── %s.h\n", child->name);
    }
    fprintf(f, "│   ├── .cboot\n");
    fprintf(f, "│   ├── README.md\n");
    if (!is_external) {
        fprintf(f, "│   ├── API.md\n");
        fprintf(f, "│   ├── DEV.md\n");
        fprintf(f, "│   └── CMakeLists.txt\n");
    }
}

/* 写入目录结构章节 */
static void docgen_proj_readme_write_tree(Project *proj, FILE *f) {
    fprintf(f, "## 目录结构\n\n```\n");
    fprintf(f, "%s/\n", proj->name);
    fprintf(f, "├── CMakeLists.txt\n├── README.md\n├── DEV.md\n├── DEPENDENCIES.md\n");
    for (int i = 0; i < proj->root->child_count; i++) {
        Domain *child = proj->root->children[i];
        if (child->type == DOMAIN_MODULE) docgen_proj_readme_write_mod_entry(child, f);
    }
    fprintf(f, "└── .cboot\n```\n\n");
}

static void docgen_generate_project_readme(Project *proj, const char *output_dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/README.md", output_dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s\n\n", proj->name);
    if (proj->root->comment) fprintf(f, "%s\n\n", proj->root->comment);

    fprintf(f, "## 文档\n\n- [开发文档](DEV.md)\n- [依赖关系](DEPENDENCIES.md)\n\n");

    docgen_proj_readme_write_modules(proj, f);
    docgen_proj_readme_write_tree(proj, f);

    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}

/* ================================================================== */
/* docgen_generate_project_dev - project-level DEV.md                        */
/* ================================================================== */

/* 写入模块的函数列表 */
static void docgen_dev_write_funcs(Domain *mod, FILE *f) {
    int has = 0;
    for (int j = 0; j < mod->child_count; j++) {
        Domain *item = mod->children[j];
        if (item->type != DOMAIN_FUNCTION) continue;
        FunctionDomain *func = (FunctionDomain *)item;
        if (!has) { fprintf(f, "**函数:**\n\n"); has = 1; }
        fprintf(f, "- `%s %s()`", func->return_type, item->name);
        if (item->comment) fprintf(f, " — %s", item->comment);
        if (func->value) fprintf(f, "  \n  逻辑: %s", func->value);
        fprintf(f, "\n");
    }
    if (has) fprintf(f, "\n");
}

/* 写入模块的类型/结构体列表 */
static void docgen_dev_write_types(Domain *mod, FILE *f) {
    int has = 0;
    for (int j = 0; j < mod->child_count; j++) {
        Domain *item = mod->children[j];
        if (item->type != DOMAIN_STRUCT && item->type != DOMAIN_TYPE) continue;
        if (!has) { fprintf(f, "**类型:**\n\n"); has = 1; }
        fprintf(f, "- `%s`", item->name);
        if (item->comment) fprintf(f, " — %s", item->comment);
        fprintf(f, "\n");
    }
    if (has) fprintf(f, "\n");
}

/* 写入模块的宏列表 */
static void docgen_dev_write_macros(Domain *mod, FILE *f) {
    int has = 0;
    for (int j = 0; j < mod->child_count; j++) {
        Domain *item = mod->children[j];
        if (item->type != DOMAIN_MACRO) continue;
        MacroDomain *md = (MacroDomain *)item;
        if (!has) { fprintf(f, "**宏:**\n\n"); has = 1; }
        fprintf(f, "- `%s`", item->name);
        if (md->value) fprintf(f, " = `%s`", md->value);
        if (item->comment) fprintf(f, " — %s", item->comment);
        fprintf(f, "\n");
    }
    if (has) fprintf(f, "\n");
}

/* 写入项目级 DEV.md 的依赖链章节 */
static void docgen_dev_write_deps(Project *proj, FILE *f) {
    if (proj->dep_count == 0 && proj->import_count == 0) return;
    fprintf(f, "## 依赖链\n\n");
    fprintf(f, "详见 [DEPENDENCIES.md](DEPENDENCIES.md)。\n\n");
    if (proj->dep_count > 0) {
        fprintf(f, "### API 依赖摘要\n\n");
        fprintf(f, "```\n");
        for (int i = 0; i < proj->dep_count; i++) {
            fprintf(f, "%s --> %s\n",
                    proj->dependencies[i].importer,
                    proj->dependencies[i].source);
        }
        fprintf(f, "```\n\n");
    }
}

static void docgen_generate_project_dev(Project *proj, const char *output_dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/DEV.md", output_dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s 开发文档\n\n", proj->name);
    if (proj->root->comment) fprintf(f, "%s\n\n", proj->root->comment);

    /* 模块概览表格 */
    fprintf(f, "## 模块概览\n\n");
    fprintf(f, "| 模块 | 说明 | 路径 |\n");
    fprintf(f, "|------|------|------|\n");
    for (int i = 0; i < proj->root->child_count; i++) {
        Domain *child = proj->root->children[i];
        if (child->type != DOMAIN_MODULE) continue;
        fprintf(f, "| `%s` | %s | %s/ |\n",
                child->name,
                child->comment ? child->comment : "-",
                child->name);
    }
    fprintf(f, "\n");

    /* 模块详细内容 */
    fprintf(f, "## 模块详细内容\n\n");
    for (int i = 0; i < proj->root->child_count; i++) {
        Domain *child = proj->root->children[i];
        if (child->type != DOMAIN_MODULE) continue;
        fprintf(f, "### %s\n\n", child->name);
        if (child->comment) fprintf(f, "%s\n\n", child->comment);
        docgen_dev_write_funcs(child, f);
        docgen_dev_write_types(child, f);
        docgen_dev_write_macros(child, f);
        fprintf(f, "详细文档见 [%s](%s/DEV.md)。\n\n", child->name, child->name);
    }

    docgen_dev_write_deps(proj, f);
    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}

/* ================================================================== */
/* docgen_generate_mod_readme - module README.md                              */
/* ================================================================== */

/* 判断是否为可枚举的内容项（函数/结构体/类型/宏） */
static int docgen_is_item(Domain *c) {
    return c->type == DOMAIN_FUNCTION || c->type == DOMAIN_STRUCT ||
           c->type == DOMAIN_TYPE || c->type == DOMAIN_MACRO;
}

/* 写入子模块链接章节 */
static void docgen_readme_write_submodules(Domain *mod, FILE *f) {
    int has_children = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *sub = mod->children[i];
        if (sub->type != DOMAIN_MODULE) continue;
        if (!has_children) { fprintf(f, "## 子模块\n\n"); has_children = 1; }
        fprintf(f, "- [%s](%s/README.md)", sub->name, sub->name);
        if (sub->comment) fprintf(f, ": %s", sub->comment);
        fprintf(f, "\n");
    }
    if (has_children) fprintf(f, "\n");
}

/* 写入内容概览表格 */
static void docgen_readme_write_item_summary(Domain *mod, FILE *f) {
    int total_items = 0;
    for (int i = 0; i < mod->child_count; i++) {
        if (docgen_is_item(mod->children[i])) total_items++;
    }
    if (total_items == 0) return;

    fprintf(f, "## 内容概览\n\n");
    int first = 1;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *c = mod->children[i];
        if (!docgen_is_item(c)) continue;
        if (first) {
            fprintf(f, "| 名称 | 类型 | API | 说明 |\n");
            fprintf(f, "|------|------|-----|------|\n");
            first = 0;
        }
        fprintf(f, "| `%s` | %s | %s | %s |\n",
                c->name,
                docgen_domain_type_str(c->type),
                docgen_is_api(c) ? "✓" : "—",
                c->comment ? c->comment : "-");
    }
    fprintf(f, "\n");
}

static void docgen_generate_mod_readme(Domain *mod, const char *dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/README.md", dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s\n\n", mod->name);
    if (mod->comment) fprintf(f, "%s\n\n", mod->comment);

    fprintf(f, "## 文档\n\n");
    fprintf(f, "- [API 文档](API.md) — 公开接口定义\n");
    fprintf(f, "- [开发文档](DEV.md) — 内部设计与实现\n\n");

    docgen_readme_write_submodules(mod, f);
    docgen_readme_write_item_summary(mod, f);

    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}

/* ================================================================== */
/* docgen_generate_mod_api - module API.md                                    */
/* ================================================================== */

static int docgen_api_write_toc(Domain *mod, FILE *f) {
    int has_any = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (docgen_is_api(child)) {
            if (!has_any) {
                fprintf(f, "## 目录\n\n");
                has_any = 1;
            }
            fprintf(f, "- [%s](#%s)\n", child->name, child->name);
        }
    }
    if (has_any) fprintf(f, "\n---\n\n");
    return has_any;
}

/* 写函数签名：return_type name(param1, param2, ...) */
static void docgen_write_func_signature(FunctionDomain *func, FILE *f) {
    fprintf(f, "```c\n%s %s(", func->return_type, ((Domain *)func)->name);
    int first = 1;
    Domain *parent = (Domain *)func;
    for (int j = 0; j < parent->child_count; j++) {
        Domain *param = parent->children[j];
        if (param->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)param;
        if (!first) fprintf(f, ", ");
        fprintf(f, "%s %s", mb->type, param->name);
        first = 0;
    }
    fprintf(f, ")\n```\n\n");
}

/* 写函数参数表格；返回是否有参数 */
static int docgen_write_func_params(Domain *func_domain, FILE *f) {
    int has_params = 0;
    for (int j = 0; j < func_domain->child_count; j++) {
        Domain *param = func_domain->children[j];
        if (param->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)param;
        if (!has_params) {
            fprintf(f, "**参数**:\n\n");
            fprintf(f, "| 名称 | 类型 | 说明 |\n");
            fprintf(f, "|------|------|------|\n");
            has_params = 1;
        }
        fprintf(f, "| `%s` | `%s` | %s |\n",
                param->name, mb->type,
                param->comment ? param->comment : "-");
    }
    return has_params;
}

static int docgen_api_write_functions(Domain *mod, FILE *f) {
    int has_funcs = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type != DOMAIN_FUNCTION || !docgen_is_api(child)) continue;
        if (!has_funcs) {
            fprintf(f, "## 函数\n\n");
            has_funcs = 1;
        }

        FunctionDomain *func = (FunctionDomain *)child;
        fprintf(f, "### %s %s()\n\n", func->return_type, child->name);
        if (child->comment) fprintf(f, "%s\n\n", child->comment);

        /* Signature */
        docgen_write_func_signature(func, f);

        /* Parameters */
        if (docgen_write_func_params(child, f)) fprintf(f, "\n");
    }
    return has_funcs;
}

/* 前向声明：dev 文档的类型/成员写入函数（被 API 文档复用） */
static void docgen_dev_write_type_def(Domain *child, FILE *f);
static void docgen_dev_write_members(Domain *child, FILE *f);

static int docgen_api_write_types(Domain *mod, FILE *f) {
    int has_types = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if ((child->type != DOMAIN_STRUCT && child->type != DOMAIN_TYPE) || !docgen_is_api(child))
            continue;
        if (!has_types) { fprintf(f, "## 类型\n\n"); has_types = 1; }

        fprintf(f, "### %s\n\n", child->name);
        if (child->comment) fprintf(f, "%s\n\n", child->comment);

        docgen_dev_write_type_def(child, f);
        docgen_dev_write_members(child, f);
    }
    return has_types;
}

static int docgen_api_write_macros(Domain *mod, FILE *f) {
    int has_macros = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type == DOMAIN_MACRO && docgen_is_api(child)) {
            if (!has_macros) {
                fprintf(f, "## 宏\n\n");
                has_macros = 1;
            }

            MacroDomain *md = (MacroDomain *)child;
            fprintf(f, "### `%s`\n\n", child->name);
            if (child->comment) fprintf(f, "%s\n\n", child->comment);
            fprintf(f, "```c\n#define %s", child->name);
            if (md->value) fprintf(f, " %s", md->value);
            fprintf(f, "\n```\n\n");
        }
    }
    return has_macros;
}

static int docgen_api_write_submodules(Domain *mod, FILE *f) {
    int has_subs = 0;
    for (int i = 0; i < mod->child_count; i++) {
        if (mod->children[i]->type == DOMAIN_MODULE) {
            if (!has_subs) {
                fprintf(f, "## 子模块\n\n");
                has_subs = 1;
            }
            Domain *sub = mod->children[i];
            fprintf(f, "- [%s API](%s/API.md)", sub->name, sub->name);
            fprintf(f, "\n");
        }
    }
    if (has_subs) fprintf(f, "\n");
    return has_subs;
}

static void docgen_generate_mod_api(Domain *mod, const char *dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/API.md", dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s API 文档\n\n", mod->name);
    fprintf(f, "本文档列出 `%s` 模块的所有公开 API。\n\n", mod->name);

    docgen_api_write_toc(mod, f);
    int has_funcs = docgen_api_write_functions(mod, f);
    int has_types = docgen_api_write_types(mod, f);
    int has_macros = docgen_api_write_macros(mod, f);

    if (!has_funcs && !has_types && !has_macros) {
        fprintf(f, "> 此模块没有公开 API。\n\n");
    }

    docgen_api_write_submodules(mod, f);

    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}

/* ================================================================== */
/* docgen_generate_mod_dev - module DEV.md                                    */
/* ================================================================== */

/* 写入函数签名 */
static void docgen_dev_write_signature(FunctionDomain *func, Domain *child, FILE *f) {
    fprintf(f, "```c\n%s %s(", func->return_type, child->name);
    int first = 1;
    for (int j = 0; j < child->child_count; j++) {
        Domain *param = child->children[j];
        if (param->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)param;
        if (!first) fprintf(f, ", ");
        fprintf(f, "%s %s", mb->type, param->name);
        first = 0;
    }
    fprintf(f, ")\n```\n\n");
}

/* 写入函数参数表格 */
static void docgen_dev_write_params(Domain *child, FILE *f) {
    int has_params = 0;
    for (int j = 0; j < child->child_count; j++) {
        Domain *param = child->children[j];
        if (param->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)param;
        if (!has_params) {
            fprintf(f, "**参数列表**:\n\n");
            fprintf(f, "| 名称 | 类型 | 说明 |\n");
            fprintf(f, "|------|------|------|\n");
            has_params = 1;
        }
        fprintf(f, "| `%s` | `%s` | %s |\n",
                param->name, mb->type,
                param->comment ? param->comment : "-");
    }
    if (has_params) fprintf(f, "\n");
}

/* 写入函数局部变量 */
static void docgen_dev_write_locals(Domain *child, FILE *f) {
    int has_vars = 0;
    for (int j = 0; j < child->child_count; j++) {
        Domain *var = child->children[j];
        if (var->type != DOMAIN_VARIABLE) continue;
        VariableDomain *v = (VariableDomain *)var;
        if (!has_vars) { fprintf(f, "**局部变量**:\n\n"); has_vars = 1; }
        fprintf(f, "- `%s` (`%s`)", var->name, v->type);
        if (var->comment) fprintf(f, ": %s", var->comment);
        fprintf(f, "\n");
    }
    if (has_vars) fprintf(f, "\n");
}

static void docgen_write_dev_functions(Domain *mod, FILE *f) {
    int has_funcs = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type != DOMAIN_FUNCTION) continue;
        if (!has_funcs) { fprintf(f, "## 函数\n\n"); has_funcs = 1; }

        FunctionDomain *func = (FunctionDomain *)child;
        fprintf(f, "### %s %s()\n\n", func->return_type, child->name);
        if (docgen_is_api(child)) fprintf(f, "> `API` — 公开接口\n\n");
        if (func->value) fprintf(f, "**业务逻辑**: %s\n\n", func->value);
        if (child->comment) fprintf(f, "**说明**: %s\n\n", child->comment);

        docgen_dev_write_signature(func, child, f);
        docgen_dev_write_params(child, f);
        docgen_dev_write_locals(child, f);

        fprintf(f, "---\n\n");
    }
}

/* 写入类型定义代码块 */
static void docgen_dev_write_type_def(Domain *child, FILE *f) {
    if (child->type == DOMAIN_TYPE) {
        TypeDomain *td = (TypeDomain *)child;
        if (td->mode == TYPE_MODE_RENAME || td->mode == TYPE_MODE_API_RENAME) {
            fprintf(f, "```c\ntypedef %s %s;\n```\n\n",
                    td->value ? td->value : "int", child->name);
        } else {
            fprintf(f, "```c\ntypedef struct %s { ... } %s;\n```\n\n",
                    child->name, child->name);
        }
        return;
    }
    /* DOMAIN_STRUCT */
    fprintf(f, "```c\ntypedef struct %s {\n", child->name);
    for (int j = 0; j < child->child_count; j++) {
        Domain *mem = child->children[j];
        if (mem->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)mem;
        fprintf(f, "    %s %s;\n", mb->type, mem->name);
    }
    fprintf(f, "} %s;\n```\n\n", child->name);
}

/* 写入成员表格 */
static void docgen_dev_write_members(Domain *child, FILE *f) {
    if (child->child_count == 0) return;
    fprintf(f, "**成员**:\n\n");
    fprintf(f, "| 名称 | 类型 | 说明 |\n");
    fprintf(f, "|------|------|------|\n");
    for (int j = 0; j < child->child_count; j++) {
        Domain *mem = child->children[j];
        if (mem->type != DOMAIN_MEMBER) continue;
        MemberDomain *mb = (MemberDomain *)mem;
        fprintf(f, "| `%s` | `%s` | %s |\n",
                mem->name, mb->type,
                mem->comment ? mem->comment : "-");
    }
    fprintf(f, "\n");
}

static void docgen_write_dev_types(Domain *mod, FILE *f) {
    int has_types = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type != DOMAIN_STRUCT && child->type != DOMAIN_TYPE) continue;
        if (!has_types) { fprintf(f, "## 类型\n\n"); has_types = 1; }

        fprintf(f, "### %s\n\n", child->name);
        if (docgen_is_api(child)) fprintf(f, "> `API` — 公开类型\n\n");
        if (child->comment) fprintf(f, "**说明**: %s\n\n", child->comment);

        docgen_dev_write_type_def(child, f);
        docgen_dev_write_members(child, f);

        fprintf(f, "---\n\n");
    }
}

static void docgen_write_dev_macros(Domain *mod, FILE *f) {
    int has_macros = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type == DOMAIN_MACRO) {
            if (!has_macros) {
                fprintf(f, "## 宏\n\n");
                has_macros = 1;
            }

            MacroDomain *md = (MacroDomain *)child;
            fprintf(f, "### `%s`\n\n", child->name);

            if (docgen_is_api(child)) {
                fprintf(f, "> `API` — 公开宏\n\n");
            }

            if (child->comment) {
                fprintf(f, "**说明**: %s\n\n", child->comment);
            }

            fprintf(f, "```c\n#define %s", child->name);
            if (md->value) fprintf(f, " %s", md->value);
            fprintf(f, "\n```\n\n");
        }
    }
    if (has_macros) fprintf(f, "\n");
}

/* 写入 API/私有项统计章节 */
static void docgen_dev_write_stats(Domain *mod, FILE *f) {
    int api_count = 0, private_count = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *c = mod->children[i];
        if (!docgen_is_item(c)) continue;
        if (docgen_is_api(c)) api_count++;
        else private_count++;
    }
    if (api_count == 0 && private_count == 0) return;
    fprintf(f, "## 统计\n\n");
    fprintf(f, "- 公开 API: **%d** 项\n", api_count);
    fprintf(f, "- 私有实现: **%d** 项\n\n", private_count);
}

/* 写入子模块链接章节（DEV.md 用 DEV.md 链接） */
static void docgen_dev_write_child_links(Domain *mod, FILE *f) {
    int has = 0;
    for (int i = 0; i < mod->child_count; i++) {
        Domain *child = mod->children[i];
        if (child->type != DOMAIN_MODULE) continue;
        if (!has) { fprintf(f, "## 子模块\n\n"); has = 1; }
        fprintf(f, "- [%s](%s/DEV.md)", child->name, child->name);
        if (child->comment) fprintf(f, ": %s", child->comment);
        fprintf(f, "\n");
    }
    if (has) fprintf(f, "\n");
}

static void docgen_generate_mod_dev(Domain *mod, const char *dir) {
    char file_path[MAX_PATH_LEN];
    snprintf(file_path, sizeof(file_path), "%s/DEV.md", dir);

    FILE *f = fopen(file_path, "w");
    if (!f) return;

    fprintf(f, "# %s 开发文档\n\n", mod->name);
    if (mod->comment) fprintf(f, "%s\n\n", mod->comment);

    docgen_dev_write_stats(mod, f);
    docgen_write_dev_functions(mod, f);
    docgen_write_dev_types(mod, f);
    docgen_write_dev_macros(mod, f);
    docgen_dev_write_child_links(mod, f);

    fprintf(f, "*Generated by CBoot v%s*\n", CBOOT_VERSION);
    fclose(f);
}
