# CBoot minimal file for module typecheck
mod typecheck
cmt "类型检查器"
struct TypeChecker
mode api
cmt "类型检查器"
mem scope Domain*
cmt "作用域"
mem error_buf char*
cmt "错误缓冲区"
mem error_len int
cmt "错误长度"
void type_checker_init void
mode api
cmt "初始化"
mem tc TypeChecker*
cmt "类型检查器"
mem scope Domain*
cmt "作用域"
void type_checker_validate int
mode api
cmt "验证类型"
mem tc TypeChecker*
cmt "类型检查器"
mem type_name char*
cmt "类型名"
void type_checker_is_builtin int
mode api
cmt "是否内置类型"
mem type_name char*
cmt "类型名"
void type_checker_validate_value int
mode api
cmt "验证值"
mem type_name char*
cmt "类型名"
mem value char*
cmt "值"

# End of .cboot for typecheck
