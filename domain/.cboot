void core_project_add_dependency void
cd core_project_add_dependency
mode api
mem proj Project*
mem importer_path const char*
mem source_path const char*
mem cboot_file const char*
tcode <<EOF
Project *p = domain_core_project_new("coredep");
domain_core_project_add_dependency(p, "/a", "/b", "b/.cboot");
int has = domain_core_project_has_dependency(p, "/a", "/b");
EXPECT(has == 1, "core_add_dependency: should have /a->/b, got %d", has);
int no_has = domain_core_project_has_dependency(p, "/a", "/c");
EXPECT(no_has == 0, "core_add_dependency: should not have /a->/c, got %d", no_has);
domain_core_project_free(p);
EOF
cd ..
void core_project_has_dependency int
cd core_project_has_dependency
mode api
mem proj Project*
mem importer_path const char*
mem source_path const char*
tcode <<EOF
Project *p = domain_core_project_new("corehas");
EXPECT(domain_core_project_has_dependency(p, "/x", "/y") == 0, "core_has_dependency: should return 0 for non-existent");
domain_core_project_add_dependency(p, "/x", "/y", "y/.cboot");
EXPECT(domain_core_project_has_dependency(p, "/x", "/y") == 1, "core_has_dependency: should return 1 after add");
EXPECT(domain_core_project_has_dependency(p, "/y", "/x") == 0, "core_has_dependency: should return 0 for reverse");
domain_core_project_free(p);
EOF
