void find_child_comment Comment*
cd find_child_comment
mode api
mem domain Domain*
mem target const char*
tcode <<EOF
ModuleDomain *parent = domain_module_domain_new("parent");
FunctionDomain *child = domain_function_domain_new("bar", "void");
domain_domain_add_child((Domain *)parent, (Domain *)child);
domain_domain_set_child_comment((Domain *)parent, "bar", "found_it");
Comment *cmt = domain_find_child_comment((Domain *)parent, "bar");
EXPECT(cmt != NULL && cmt->text != NULL && strcmp(cmt->text, "found_it") == 0, "find_child_comment wrong: %s", cmt && cmt->text ? cmt->text : "NULL");
Comment *no_cmt = domain_find_child_comment((Domain *)parent, "nonexistent");
EXPECT(no_cmt == NULL, "find_child_comment(nonexistent) should return NULL");
domain_domain_delete((Domain *)parent);
EOF
