EXPECT(cmt != NULL, "set_child_comment: comment is NULL");
EXPECT(cmt->text != NULL && strcmp(cmt->text, "child comment") == 0, "set_child_comment content wrong: %s", cmt && cmt->text ? cmt->text : "NULL");
domain_domain_delete((Domain *)parent);
EOF
