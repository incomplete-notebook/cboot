void core_project_would_cycle int
cd core_project_would_cycle
mode api
mem proj Project*
mem importer_path const char*
mem source_path const char*
tcode <<EOF
Project *p = domain_core_project_new("corecycle");
domain_core_project_add_dependency(p, "/mod_a", "/mod_b", "mod_b/.cboot");
int would = domain_core_project_would_cycle(p, "/mod_b", "/mod_a");
EXPECT(would == 1, "core_would_cycle: B->A should cycle, got %d", would);
int no_cycle = domain_core_project_would_cycle(p, "/mod_a", "/mod_b");
EXPECT(no_cycle == 0, "core_would_cycle: A->B should not cycle, got %d", no_cycle);
int no_dep = domain_core_project_would_cycle(p, "/mod_c", "/mod_d");
EXPECT(no_dep == 0, "core_would_cycle: C->D should not cycle, got %d", no_dep);
domain_core_project_free(p);
EOF
cd ..
