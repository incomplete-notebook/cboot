void project_would_cycle int
cd project_would_cycle
mode api
mem proj Project*
mem importer_path const char*
mem source_path const char*
tcode <<EOF
Project *p = domain_project_new("cycleproj");
domain_project_add_dependency(p, "/mod_a", "/mod_b", "mod_b/.cboot");
int would = domain_project_would_cycle(p, "/mod_b", "/mod_a");
EXPECT(would == 1, "would_cycle: B->A should cycle (A->B exists), got %d", would);
int no_cycle = domain_project_would_cycle(p, "/mod_a", "/mod_b");
EXPECT(no_cycle == 0, "would_cycle: A->B should not cycle (same direction), got %d", no_cycle);
int no_dep = domain_project_would_cycle(p, "/mod_c", "/mod_d");
EXPECT(no_dep == 0, "would_cycle: C->D should not cycle (no deps), got %d", no_dep);
domain_project_free(p);
EOF
