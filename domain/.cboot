void domain_add_child void
cd domain_add_child
mode api
mem parent Domain*
mem child Domain*
tcode <<EOF
ModuleDomain *parent = domain_module_domain_new("parent");
FunctionDomain *child = domain_function_domain_new("child_fn", "void");
EXPECT(parent != NULL && child != NULL, "add_child setup failed");
domain_domain_add_child((Domain *)parent, (Domain *)child);
EXPECT(parent->base.child_count == 1, "add_child count wrong: %d", parent->base.child_count);
Domain *found = domain_domain_find_child((Domain *)parent, "child_fn");
EXPECT(found != NULL, "add_child find_child failed");
domain_domain_delete((Domain *)parent);
EOF
cd ..
void domain_find_child Domain*
cd domain_find_child
mode api
mem parent Domain*
mem name const char*
tcode <<EOF
ModuleDomain *parent = domain_module_domain_new("parent");
FunctionDomain *child = domain_function_domain_new("foo", "void");
domain_domain_add_child((Domain *)parent, (Domain *)child);
Domain *found = domain_domain_find_child((Domain *)parent, "foo");
EXPECT(found != NULL, "find_child(foo) returned NULL");
Domain *not_found = domain_domain_find_child((Domain *)parent, "bar");
EXPECT(not_found == NULL, "find_child(bar) should return NULL");
domain_domain_delete((Domain *)parent);
EOF
