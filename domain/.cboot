EXPECT(domain_project_has_dependency(p, "/x", "/y") == 0, "has_dependency: should return 0 for non-existent");
domain_project_add_dependency(p, "/x", "/y", "y/.cboot");
EXPECT(domain_project_has_dependency(p, "/x", "/y") == 1, "has_dependency: should return 1 after add");
EXPECT(domain_project_has_dependency(p, "/y", "/x") == 0, "has_dependency: should return 0 for reverse");
domain_project_free(p);
EOF
