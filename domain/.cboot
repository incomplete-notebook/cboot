void project_add_dependency void
cd project_add_dependency
mode api
mem proj Project*
mem importer_path const char*
mem source_path const char*
mem cboot_file const char*
tcode <<EOF
Project *p = domain_project_new("depproj");
domain_project_add_dependency(p, "/mod_a", "/mod_b", "mod_b/.cboot");
int has = domain_project_has_dependency(p, "/mod_a", "/mod_b");
EXPECT(has == 1, "add_dependency: should have dependency mod_a->mod_b, got %d", has);
int no_has = domain_project_has_dependency(p, "/mod_a", "/mod_c");
EXPECT(no_has == 0, "add_dependency: should not have dependency mod_a->mod_c, got %d", no_has);
domain_project_free(p);
EOF
