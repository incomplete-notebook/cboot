void domain_set_value void
cd domain_set_value
mode api
mem domain Domain*
mem value const char*
tcode <<EOF
MacroDomain *macro = domain_macro_domain_new("MYMACRO");
domain_domain_set_value((Domain *)macro, "42");
EXPECT(macro->value != NULL, "set_value value is NULL");
