tcode <<EOF
EXPECT(domain_core_is_builtin_type("int") == 1, "core_is_builtin_type(int) should be 1");
EXPECT(domain_core_is_builtin_type("char") == 1, "core_is_builtin_type(char) should be 1");
EXPECT(domain_core_is_builtin_type("foobar") == 0, "core_is_builtin_type(foobar) should be 0");
EXPECT(domain_core_is_builtin_type(NULL) == 0, "core_is_builtin_type(NULL) should be 0");
EOF
