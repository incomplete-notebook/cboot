void domain_remove_child void
cd domain_remove_child
mode api
mem parent Domain*
mem child Domain*
tcode <<EOF
ModuleDomain *parent = domain_module_domain_new("parent");
FunctionDomain *child = domain_function_domain_new("foo", "void");
domain_domain_add_child((Domain *)parent, (Domain *)child);
EXPECT(parent->base.child_count == 1, "remove_child setup count wrong: %d", parent->base.child_count);
domain_domain_remove_child((Domain *)parent, (Domain *)child);
EXPECT(parent->base.child_count == 0, "remove_child count should be 0: %d", parent->base.child_count);
domain_domain_delete((Domain *)parent);
domain_domain_delete((Domain *)child);
EOF
cd ..
void domain_find_nearest_of_type Domain*
cd domain_find_nearest_of_type
mode api
mem from Domain*
mem type DomainType
tcode <<EOF
ModuleDomain *root = domain_module_domain_new("root");
ModuleDomain *child = domain_module_domain_new("child");
FunctionDomain *fn = domain_function_domain_new("fn", "int");
domain_domain_add_child((Domain *)root, (Domain *)child);
domain_domain_add_child((Domain *)child, (Domain *)fn);
Domain *nearest = domain_domain_find_nearest_of_type((Domain *)fn, DOMAIN_MODULE);
EXPECT(nearest != NULL, "find_nearest_of_type returned NULL");
EXPECT(nearest == (Domain *)child, "find_nearest_of_type should find 'child'");
domain_domain_delete((Domain *)root);
EOF
cd ..
void domain_find_in_tree Domain*
cd domain_find_in_tree
mode api
mem root Domain*
mem type DomainType
mem name const char*
tcode <<EOF
ModuleDomain *root = domain_module_domain_new("root");
ModuleDomain *child = domain_module_domain_new("child");
FunctionDomain *fn = domain_function_domain_new("target", "int");
domain_domain_add_child((Domain *)root, (Domain *)child);
domain_domain_add_child((Domain *)child, (Domain *)fn);
Domain *found = domain_domain_find_in_tree((Domain *)root, DOMAIN_FUNCTION, "target");
EXPECT(found != NULL, "find_in_tree(target) returned NULL");
EXPECT(found == (Domain *)fn, "find_in_tree should find 'target'");
Domain *not_found = domain_domain_find_in_tree((Domain *)root, DOMAIN_FUNCTION, "nonexistent");
EXPECT(not_found == NULL, "find_in_tree(nonexistent) should return NULL");
domain_domain_delete((Domain *)root);
EOF
cd ..
void domain_get_path char*
cd domain_get_path
mode api
mem domain Domain*
tcode <<EOF
Project *proj = domain_project_new("rootproj");
EXPECT(proj != NULL && proj->root != NULL, "get_path setup failed");
ModuleDomain *m1 = domain_module_domain_new("m1");
domain_domain_add_child(proj->root, (Domain *)m1);
char *path = domain_domain_get_path((Domain *)m1);
EXPECT(path != NULL, "get_path returned NULL");
EXPECT(strstr(path, "m1") != NULL, "get_path should contain 'm1': %s", path ? path : "NULL");
free(path);
domain_project_free(proj);
EOF
cd ..
void domain_is_api int
cd domain_is_api
mode api
mem domain Domain*
tcode <<EOF
ModuleDomain *mod = domain_module_domain_new("m");
FunctionDomain *api_fn = domain_function_domain_new("api_fn", "int");
api_fn->mode = API_MODE_API;
FunctionDomain *priv_fn = domain_function_domain_new("priv_fn", "int");
priv_fn->mode = API_MODE_NORMAL;
domain_domain_add_child((Domain *)mod, (Domain *)api_fn);
domain_domain_add_child((Domain *)mod, (Domain *)priv_fn);
EXPECT(domain_domain_is_api((Domain *)api_fn) == 1, "is_api should return 1 for API function");
EXPECT(domain_domain_is_api((Domain *)priv_fn) == 0, "is_api should return 0 for non-API function");
domain_domain_delete((Domain *)mod);
EOF
cd ..
void domain_find_api_in_submodules Domain*
cd domain_find_api_in_submodules
mode api
mem scope Domain*
mem name const char*
tcode <<EOF
ModuleDomain *root = domain_module_domain_new("root");
ModuleDomain *sub = domain_module_domain_new("sub");
FunctionDomain *api_fn = domain_function_domain_new("findme", "int");
api_fn->mode = API_MODE_API;
domain_domain_add_child((Domain *)root, (Domain *)sub);
domain_domain_add_child((Domain *)sub, (Domain *)api_fn);
Domain *found = domain_domain_find_api_in_submodules((Domain *)root, "findme");
EXPECT(found != NULL, "find_api_in_submodules(findme) returned NULL");
EXPECT(found == (Domain *)api_fn, "find_api_in_submodules should find 'findme'");
Domain *not_found = domain_domain_find_api_in_submodules((Domain *)root, "nonexistent");
EXPECT(not_found == NULL, "find_api_in_submodules(nonexistent) should return NULL");
domain_domain_delete((Domain *)root);
EOF
cd ..
void domain_check_api_name_conflict Domain*
cd domain_check_api_name_conflict
mode api
mem scope Domain*
mem name const char*
tcode <<EOF
ModuleDomain *root = domain_module_domain_new("root");
ModuleDomain *sub = domain_module_domain_new("sub");
FunctionDomain *api_fn = domain_function_domain_new("conflict", "int");
api_fn->mode = API_MODE_API;
domain_domain_add_child((Domain *)root, (Domain *)sub);
domain_domain_add_child((Domain *)sub, (Domain *)api_fn);
Domain *conflict = domain_domain_check_api_name_conflict((Domain *)root, "conflict");
EXPECT(conflict != NULL, "check_api_name_conflict should find conflict");
Domain *no_conflict = domain_domain_check_api_name_conflict((Domain *)root, "noconflict");
EXPECT(no_conflict == NULL, "check_api_name_conflict should return NULL for no conflict");
domain_domain_delete((Domain *)root);
EOF
cd ..
