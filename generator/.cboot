im domain
void generate_project int
cd generate_project
mode api
cmt "输出目录(项目根即为源码根)"
value "递归处理所有模块，生成.c/.h/层级化CMake/文档/DEPENDENCIES.md"
mem proj Project*
tcode <<EOF
const char *tdir = "/tmp/cboot_test_gen_proj";
char cmd[256];
snprintf(cmd, sizeof(cmd), "rm -rf %s && mkdir -p %s", tdir, tdir);
system(cmd);
char cwd[1024]; getcwd(cwd, sizeof(cwd));
