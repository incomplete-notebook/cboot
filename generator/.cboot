mod->mode = MOD_MODE_SRC;
FunctionDomain *fn = domain_function_domain_new("add", "int");
fn->mode = API_MODE_API;
MemberDomain *m1 = domain_member_domain_new("a", "int");
MemberDomain *m2 = domain_member_domain_new("b", "int");
domain_domain_add_child((Domain *)fn, (Domain *)m1);
domain_domain_add_child((Domain *)fn, (Domain *)m2);
