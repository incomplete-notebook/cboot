EOF
cd ..
void generate_mod_c void
cd generate_mod_c
mem mod Domain*
mem dir const char*
tcode <<EOF
const char *td = "/tmp/cbt_gen_mod_c"; char cmd[256], cwd[1024];
snprintf(cmd, sizeof(cmd), "rm -rf %s && mkdir -p %s", td, td); system(cmd);
getcwd(cwd, sizeof(cwd)); chdir(td);
Project *p = domain_project_new("t");
ModuleDomain *m = domain_module_domain_new("mymod"); m->mode = MOD_MODE_SRC;
FunctionDomain *f = domain_function_domain_new("add", "int"); f->mode = API_MODE_API;
domain_domain_add_child((Domain*)m, (Domain*)f);
