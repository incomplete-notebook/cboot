void parse_c_decl int
cd parse_c_decl
mode api
mem decl const char*
mem type_out char*
mem type_size int
mem name_out char*
mem name_size int
tcode <<EOF
char type_out[128], name_out[128];
int rc = utils_parse_c_decl("int* foo", type_out, 128, name_out, 128);
EXPECT(rc == 0, "parse_c_decl failed");
EXPECT(strcmp(type_out, "int*") == 0, "type wrong: %s", type_out);
EXPECT(strcmp(name_out, "foo") == 0, "name wrong: %s", name_out);
rc = utils_parse_c_decl("char name", type_out, 128, name_out, 128);
EXPECT(rc == 0, "parse_c_decl 2 failed");
EXPECT(strcmp(type_out, "char") == 0, "type 2 wrong: %s", type_out);
EXPECT(strcmp(name_out, "name") == 0, "name 2 wrong: %s", name_out);
EOF
cd ..
void extract_base_type char*
cd extract_base_type
mode api
mem type_decl const char*
tcode <<EOF
char *r1 = utils_extract_base_type("int*");
EXPECT(strcmp(r1, "int") == 0, "extract_base_type('int*') => '%s', expected 'int'", r1);
char *r2 = utils_extract_base_type("char**");
EXPECT(strcmp(r2, "char") == 0, "extract_base_type('char**') => '%s', expected 'char'", r2);
char *r3 = utils_extract_base_type("void");
EXPECT(strcmp(r3, "void") == 0, "extract_base_type('void') => '%s', expected 'void'", r3);
EOF
