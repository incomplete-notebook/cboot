mem str char*
tcode <<EOF
char buf1[] = "  hello  ";
char *r1 = utils_trim(buf1);
EXPECT(strcmp(r1, "hello") == 0, "trim('  hello  ') => '%s', expected 'hello'", r1);
char buf2[] = "no_spaces";
char *r2 = utils_trim(buf2);
EXPECT(strcmp(r2, "no_spaces") == 0, "trim('no_spaces') => '%s', expected 'no_spaces'", r2);
char buf3[] = "   ";
char *r3 = utils_trim(buf3);
EXPECT(*r3 == '\0', "trim('   ') should return empty string");
char buf4[] = "";
char *r4 = utils_trim(buf4);
EXPECT(*r4 == '\0', "trim('') should return empty string");
EXPECT(utils_trim(NULL) == NULL, "trim(NULL) should return NULL");
