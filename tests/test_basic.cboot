# Simple test project
project test_project
mod core
cmt "核心模块"
def VERSION
value "1"
cmt "版本号"
mode api
cd ..
type Bool
mode api rename
value "int"
cmt "布尔类型"
cd ..
struct Config
mode api
cmt "配置结构体"
mem name char*
cmt "配置名称"
cd ..
mem value int
cmt "配置值"
cd ..
cd ..
void init void
mode api
cmt "初始化函数"
value "初始化核心模块"
cd ..
gen
